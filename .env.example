# Copy this file to .env and fill in the values. Never commit .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty for local SQLite (instance/schoolsync.db).
# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Used once by `flask seed` to create the first super admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# AI provider key (Phase 2). The admin panel only stores the variable NAME.
# ANTHROPIC_API_KEY=

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: email delivery for event reminders
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=school@example.com
# SMTP_TLS=true
